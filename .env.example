# =========================
# ksrpc Docker 环境变量模板
# - 业务配置维护在根目录 config_server.py
# - gunicorn 进程参数维护在根目录 gunicorn.conf.py
# - .env 仅保留编排层参数和密钥
# =========================

# [必填] Docker Compose 使用的镜像引用
OCI_IMAGE_REF=www.yourdomain.com/ksrpc:edge

# [必填] 容器名称
KSRPC_CONTAINER_NAME=ksrpc-dev

# [必填] 主机暴露的服务端口
KSRPC_HOST_PORT=19801

# [可选] 多实例数量（./ksrpc-compose.sh）
KSRPC_INSTANCES=1

# [必填] ksrpc.server.tushare 使用的 Tushare Token（请替换为真实令牌）
TUSHARE_TOKEN=replace_with_real_tushare_token

# [可选] 官方 Tushare DataApi 地址，默认 http://api.waditu.com/dataapi
TUSHARE_HTTP_URL=http://api.waditu.com/dataapi

# [可选] 供 ksrpc.server.tushare_gateway 统计上游流量使用的 Redis
TUSHARE_GATEWAY_REDIS_URL=redis://:replace_with_real_password@127.0.0.1:6379/0

# [可选] 网关共享状态 Key 前缀
TUSHARE_GATEWAY_REDIS_KEY_PREFIX=ksrpc:tushare:gateway:dev
